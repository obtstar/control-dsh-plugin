# control 独立看板（v0.5 方案 1）：静态页 + control-api 代理
# 凭据经 EnvironmentFile 注入（0600）：CONTROL_API_USER/PASSWORD 或 CONTROL_API_TOKEN
[Unit]
Description=control 任务看板（静态 + control-api 代理）
After=network.target dsh-web.service

[Service]
Type=simple
WorkingDirectory=/home/dev/control-dsh-plugin
EnvironmentFile=/home/dev/.config/dsh-web.env
Environment=PATH=/home/dev/.nvm/versions/node/v24.19.0/bin:/usr/bin:/bin
ExecStart=/home/dev/.nvm/versions/node/v24.19.0/bin/node /home/dev/control-dsh-plugin/scripts/board.mjs 8787
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
